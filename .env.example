# Скопируйте в .env и заполните. Файл .env не коммитится.

# Токен от @BotFather
BOT__TOKEN=123456:replace-me

# PostgreSQL. В Docker Compose DB__HOST автоматически переопределяется на "db".
DB__HOST=localhost
DB__PORT=5432
DB__USER=omniradar
DB__PASSWORD=change-me
DB__NAME=omniradar

# Хранилище диалогов (FSM): memory | redis. В Docker Compose автоматически redis.
BOT__FSM_STORAGE=memory
# Адрес Mini App (https) — кнопка «Личный кабинет» в меню бота
# BOT__WEBAPP_URL=https://example.com/app

# Redis: FSM-хранилище и кэш парсеров
REDIS__URL=redis://localhost:6379/0

# Кэш выдачи площадок
CACHE__ENABLED=true
CACHE__TTL_SECONDS=90

# Прайс за один день; скидки длинных тарифов заданы в app/domain/tariffs.py
BILLING__DAY_PRICE_STARS=25
BILLING__DAY_PRICE_USD=0.50

# Mini App: адрес фронтенда (https!) — его открывает кнопка бота
# BOT__WEBAPP_URL=https://app.example.com
FRONTEND__PORT=8080

# CryptoBot (необязательно): без токена способ оплаты не показывается
# BILLING__CRYPTOBOT_TOKEN=12345:AA...

# Площадки (JSON-список кодов парсеров)
ENABLED_MARKETPLACES=["olx_ua"]

# Мониторинг
MONITORING__INTERVAL_SECONDS=60
MONITORING__CONCURRENCY=3
MONITORING__PUBLISH_GRACE_MINUTES=10
MONITORING__MAX_FILTERS_PER_USER=10
MONITORING__MAX_PRESETS_PER_USER=20

# Обход выдачи: размер страницы и максимум страниц за один проход фильтра
PARSER__PAGE_SIZE=40
PARSER__MAX_PAGES=5

# HTTP-клиент парсеров (curl_cffi)
HTTP__IMPERSONATE=chrome
HTTP__TIMEOUT_SECONDS=20
HTTP__MAX_RETRIES=3
HTTP__MIN_REQUEST_INTERVAL_SECONDS=2
# HTTP__PROXY=http://user:pass@host:port

LOG_LEVEL=INFO
